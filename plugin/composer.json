{
  "name": "wp-upload/companion-dev",
  "description": "Dev-only tooling for the wp-upload companion plugin: PHPStan with WordPress stubs. Nothing here ships.",
  "type": "project",
  "license": "MIT",
  "require-dev": {
    "phpstan/phpstan": "^2.1",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "phpstan/extension-installer": "^1.4"
  },
  "config": {
    "platform": {
      "php": "8.1.34"
    },
    "allow-plugins": {
      "phpstan/extension-installer": true
    },
    "sort-packages": true
  },
  "scripts": {
    "phpstan": "phpstan analyse --memory-limit=1G --no-progress"
  }
}
