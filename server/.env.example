# URL of your WordPress site (no trailing slash)
WP_URL=https://example.com

# WordPress username the Application Password was generated for
WP_USERNAME=your-username

# Generate under wp-admin -> Users -> Profile -> Application Passwords.
# Keep the spaces exactly as WordPress shows them.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Login required to use this app at all (entered on the app's login page).
# Pick a long, random AUTH_PASSWORD, especially if this app is reachable from
# the internet.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-something-long-and-random

# Key that signs the login session cookie - at least 32 random characters,
# e.g. the output of "openssl rand -base64 48". If unset, WP_APP_PASSWORD
# stands in for it. Changing it, AUTH_USERNAME or AUTH_PASSWORD logs out every
# browser.
# SESSION_SECRET=

# How long a login lasts, in days (1-400). Using the app renews it (at most
# once a day), so a device that uses the app at least this often stays
# logged in.
SESSION_MAX_AGE_DAYS=30

# Which client IP the login lockout sees when this app sits behind reverse
# proxies. Leave false if clients connect directly. Behind proxies, set it to
# the number of proxies in front of this app - e.g. 1 for a single nginx
# using "proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for" - so the
# address appended by the proxy is used, not one the client made up.
# Alternatively give a comma-separated list of trusted proxy IPs/CIDR subnets
# (or loopback/linklocal/uniquelocal). Avoid true: it trusts the leftmost
# X-Forwarded-For entry, which clients control unless the proxy overwrites
# the header. Whatever you set, make sure this app is only reachable through
# the proxy, or clients can send their own X-Forwarded-For directly.
# Behind an HTTPS proxy that sends X-Forwarded-Proto, this is also what makes
# the session cookie Secure.
TRUST_PROXY=false

# Optional overrides
# HOST=0.0.0.0 binds to all network interfaces (reachable from other devices
# on your LAN via this machine's IP). Set to 127.0.0.1 to restrict to this
# machine only.
HOST=0.0.0.0
PORT=3001
UPLOAD_CONCURRENCY=8
MAX_FILE_SIZE_MB=200
# How long to wait for WordPress before aborting a request. This must cover
# not just the upload transfer but also however long WordPress spends
# generating scaled-down versions afterwards, which can take minutes when
# many uploads are processing in parallel.
WP_REQUEST_TIMEOUT_MS=300000

# Optional: FileBird media folders support. Generate a REST API key under
# wp-admin -> Settings -> FileBird -> API. Setting it shows a folder picker
# below the drop zone so uploads can be filed straight into a folder; leave
# it unset to disable FileBird support entirely.
# FILEBIRD_API_KEY=
