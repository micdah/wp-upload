# URL of your WordPress site (no trailing slash)
WP_URL=https://example.com

# WordPress username the Application Password was generated for
WP_USERNAME=your-username

# Generate under wp-admin -> Users -> Profile -> Application Passwords.
# Keep the spaces exactly as WordPress shows them.
WP_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# Login required to use this app at all (HTTP Basic Auth - your browser will
# prompt for these). Pick a long, random AUTH_PASSWORD, especially if this
# app is reachable from the internet.
AUTH_USERNAME=admin
AUTH_PASSWORD=change-me-to-something-long-and-random

# Set to true ONLY if this app sits behind a reverse proxy that you control
# and that overwrites (not appends to) X-Forwarded-For itself. Enabling this
# without such a proxy lets any client fake their IP and bypass the login
# rate limit below.
TRUST_PROXY=false

# Optional overrides
# HOST=0.0.0.0 binds to all network interfaces (reachable from other devices
# on your LAN via this machine's IP). Set to 127.0.0.1 to restrict to this
# machine only.
HOST=0.0.0.0
PORT=3001
UPLOAD_CONCURRENCY=8
MAX_FILE_SIZE_MB=200
